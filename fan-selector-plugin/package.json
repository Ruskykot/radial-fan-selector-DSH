{
  "name": "@rusky_kot/fan-selector",
  "version": "1.0.0",
  "description": "DSH-плагин подбора радиальных вентиляторов ВР 86-77 и ВР 280-46 по расходу и давлению.",
  "license": "Apache-2.0",
  "keywords": ["deepseek-harness", "dsh-plugin", "hvac", "ventilation", "fan-selection"],
  "homepage": "https://github.com/Ruskykot/radial-fan-selector-DSH#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ruskykot/radial-fan-selector-DSH.git",
    "directory": "fan-selector-plugin"
  },
  "bugs": {
    "url": "https://github.com/Ruskykot/radial-fan-selector-DSH/issues"
  },
  "type": "module",
  "engines": {
    "dsh": ">=0.2.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "core/run_once.py",
    "core/select-radial-fan/fan_selector/**",
    "core/select-radial-fan/data/**",
    "!**/__pycache__/**"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
